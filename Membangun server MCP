    async def get_alerts(state: str) -> str:
        Dapatkan peringatan cuaca untuk sebuah negara bagian di AS.

        Argumen:
            negara bagian: Kode negara bagian AS dua huruf (misalnya CA, NY)
        """
        url = f"{NWS_API_BASE}/alerts/active/area/{state}"
        data = await make_nws_request(url)

        jika bukan data atau "fitur" tidak ada dalam data:
            mengembalikan "Tidak dapat mengambil peringatan atau tidak ada peringatan yang ditemukan."

        jika data["features"] tidak ada:
            kembali "Tidak ada peringatan aktif untuk negara bagian ini."

        peringatan = [format_alert(fitur) untuk fitur dalam data["fitur"]]
        kembalikan "\n---\n".gabungkan(peringatan)


