    ## Membangun server Anda

    ### Mengimpor paket dan mengatur konstanta

    Tambahkan ini ke bagian atas `src/index.ts` Anda:

    ```tema typescript={null}
    impor { McpServer } dari "@modelcontextprotocol/server";
    impor { serveStdio } dari "@modelcontextprotocol/server/stdio";
    impor { z } dari "zod";

    const NWS_API_BASE = "https://api.weather.gov";
    const USER_AGENT = "aplikasi cuaca/1.0";
    ```

    ### Fungsi pembantu

    Selanjutnya, mari kita tambahkan fungsi pembantu kita untuk melakukan kueri dan memformat data dari API Layanan Cuaca Nasional:

    ```tema typescript={null}
    // Fungsi pembantu untuk melakukan permintaan API NWS
    fungsi asinkron makeNWSRequest<T>(url: string): Promise<T | null> {
      const headers = {
        "Agen Pengguna": USER_AGENT,
        Terima: "application/geo+json",
      };

      mencoba {
        const response = await fetch(url, { headers });
        jika (!respons.ok) {
          throw new Error(`Kesalahan HTTP! status: ${response.status}`);
        }
        kembalikan (tunggu respons.json()) sebagai T;
      } tangkap (kesalahan) {
        console.error("Terjadi kesalahan saat melakukan permintaan NWS:", error);
        kembalikan null;
      }
    }

    antarmuka AlertFeature {
      properti: {
        acara?: string;
        Deskripsi area?: string;
        tingkat keparahan?: string;
        status?: string;
        judul?: string;
      };
    }

    // Format data peringatan
    fungsi formatAlert(fitur: AlertFeature): string {
      konstanta props = fitur.properti;
      kembali [
        `Acara: ${props.event || "Tidak Diketahui"}`,
        `Area: ${props.areaDesc || "Tidak Diketahui"}`,
        `Tingkat Keparahan: ${props.severity || "Tidak Diketahui"}`,
        `Status: ${props.status || "Tidak Diketahui"}`,
        `Judul: ${props.headline || "Tidak ada judul"}`,
        "---",
      ].join("\n");
    }

    antarmuka ForecastPeriod {
      nama?: string;
      Suhu?: angka;
      Satuan suhu?: string;
      Kecepatan angin?: string;
      Arah angin?: string;
      Prakiraan singkat?: string;
    }

    antarmuka AlertsResponse {
      fitur: AlertFeature[];
    }

    antarmuka PointsResponse {
      properti: {
        Ramalan cuaca?: string;
      };
    }

    antarmuka ForecastResponse {
      properti: {
        periode: ForecastPeriod[];
      };
    }
    ```

    ### Menerapkan eksekusi alat

    Handler eksekusi alat bertanggung jawab untuk benar-benar mengeksekusi logika setiap alat. Mari kita tambahkan di dalam fungsi `createServer()` yang membangun instance server dan mendaftarkan kedua alat tersebut di dalamnya:

    ```tema typescript={null}
    // Buat instance server dan daftarkan alat-alatnya. serveStdio memanggil ini
    // Setiap kali membutuhkan sebuah instance, maka setiap panggilan harus mengembalikan instance yang baru.
    fungsi createServer() {
      const server = new McpServer({
        nama: "cuaca",
        versi: "1.0.0",
      });

      server.registerTool(
        "mendapatkan_peringatan",
        {
          deskripsi: "Dapatkan peringatan cuaca untuk suatu negara bagian",
          inputSchema: z.object({
            keadaan: z
              .rangkaian()
              .panjang(2)
              .describe("Kode negara bagian dua huruf (misalnya CA, NY)"),
          }),
        },
        asinkron ({ state }) => {
          const stateCode = state.toUpperCase();
          const alertsUrl = `${NWS_API_BASE}/alerts?area=${stateCode}`;
          const alertsData = await makeNWSRequest<AlertsResponse>(alertsUrl);

          jika (!alertsData) {
            kembali {
              isi: [
                {
                  tipe: "teks",
                  teks: "Gagal mengambil data peringatan",
                },
              ],
            };
          }

          const features = alertsData.features || [];
          jika (!panjang fitur) {
            kembali {
              isi: [
                {
                  tipe: "teks",
                  teks: `Tidak ada peringatan aktif untuk ${stateCode}`,
                },
              ],
            };
          }

          const formattedAlerts = features.map(formatAlert);
          const alertsText = `Peringatan aktif untuk ${stateCode}:\n\n${formattedAlerts.join("\n")}`;

          kembali {
            isi: [
              {
                tipe: "teks",
                teks: peringatanTeks
